@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title [Kontenery] System ERP do zarządzania operacjami i zasobami komercyjnego portu lotniczego

' --- AKTORZY ---
Person(passenger, "Pasażer", "Osoba korzystająca z usług lotniska")
Person(staff, "Pracownik Lotniska", "Pracownik obsługi biurowej, koordynator lotów")
Person(team, "Zespół Interwencyjny", "Zespół reagujący na incydenty i obsługa naziemna")
Person(airline, "Linie Lotnicze", "Zewnętrzne systemy rezerwacji")

' --- SYSTEMY ZEWNĘTRZNE ---
System_Ext(atc, "System ATC", "Kontrola ruchu lotniczego")
System_Ext(fids, "System FIDS", "Tablice informacyjne lotniska")
System_Ext(security, "Systemy bezpieczeństwa", "Czujniki PPOŻ, monitoring")

System_Boundary(erp, "ERP Lotniska") {

    ' --- APLIKACJE (FRONTEND) ---
    Container(web_app, "Aplikacja Webowa", "Angular/React", "SPA dla Pasażerów (odprawa) i Personelu biurowego")
    Container(mobile_app, "Aplikacja Mobilna", "React Native", "Tylko dla Zespołów Interwencyjnych i Obsługi Naziemnej")

    ' --- BRAMA API ---
    Container(api_gateway, "API Gateway", "Spring Cloud Gateway", "Routing i Autoryzacja")

    ' --- MIKROSERWISY (BACKEND) ---
    Container(passenger_api, "API Pasażerowie", "Java Spring Boot", "Rezerwacje, odprawy, bilety")
    Container(flights_api, "API Loty", "Java Spring Boot", "Harmonogramy, statusy, sloty")
    Container(security_api, "API Bezpieczeństwo", "Java Spring Boot", "Incydenty, zespoły, alerty")
    Container(ground_api, "API Obsługa Naziemna", "Java Spring Boot", "Zadania, zasoby, personel")

    Container(notification_service, "Serwis Powiadomień", "Java Spring Boot", "Wysyłanie powiadomień i alertów")

    ' --- KOMUNIKACJA ASYNCHRONICZNA ---
    Container(msg_broker, "Message Broker", "Kafka/RabbitMQ", "Szyna zdarzeń")
}

' --- RELACJE UŻYTKOWNIKÓW ---
Rel(passenger, web_app, "Korzysta (Odprawa, Bilety)", "HTTPS")
Rel(staff, web_app, "Korzysta (Zarządzanie)", "HTTPS")
Rel(team, mobile_app, "Korzysta (Zadania, Raporty)", "HTTPS")

' --- RELACJE FRONTEND -> BACKEND ---
Rel(web_app, api_gateway, "Wysyła żądania", "REST/HTTPS")
Rel(mobile_app, api_gateway, "Wysyła żądania", "REST/HTTPS")

Rel(api_gateway, passenger_api, "Kieruje ruch")
Rel(api_gateway, flights_api, "Kieruje ruch")
Rel(api_gateway, security_api, "Kieruje ruch")
Rel(api_gateway, ground_api, "Kieruje ruch")

' --- BEZPOŚREDNIA KOMUNIKACJA MIĘDZY SERWISAMI (SYNCHRONICZNA - REST) ---
' Pasażer pyta o lot
Rel(passenger_api, flights_api, "Weryfikuje status lotu", "REST")
' Obsługa naziemna pobiera dane o samolocie do zadań
Rel(ground_api, flights_api, "Pobiera harmonogram", "REST")
' Bezpieczeństwo blokuje loty przy zagrożeniu
Rel(security_api, flights_api, "Blokuje operacje", "REST")
' Obsługa naziemna zgłasza awarię sprzętu jako incydent
Rel(ground_api, security_api, "Zgłasza awarie", "REST")
' Bezpieczeństwo wysyła natychmiastowy alert do ludzi
Rel(security_api, notification_service, "Zleca alerty krytyczne", "REST")

' --- KOMUNIKACJA ASYNCHRONICZNA (BROKER) ---
Rel(flights_api, msg_broker, "Publikuje zmiany statusu")
Rel(msg_broker, fids, "Aktualizuje tablice")
Rel(msg_broker, notification_service, "Triggeruje powiadomienia masowe")

' --- INTEGRACJE ZEWNĘTRZNE ---
Rel(airline, passenger_api, "Przesyła dane rezerwacji", "API/HTTPS")
Rel(atc, flights_api, "Dostarcza statusy i sloty", "API/HTTPS")
Rel(security, security_api, "Przesyła alerty (IoT)", "MQTT/API")

@enduml